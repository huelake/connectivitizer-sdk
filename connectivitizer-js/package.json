{
  "name": "@huelake/connectivitizer",
  "version": "1.0.50",
  "description": "Connectivitizer SDK for Node.js and React Native: reach services on devices behind NAT, end-to-end encrypted, relayed or peer to peer.",
  "license": "MIT",
  "author": "Huelake Software Solutions UG (haftungsbeschränkt) <info@huelake.com>",
  "homepage": "https://connectivitizer.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huelake/connectivitizer-sdk.git",
    "directory": "connectivitizer-js"
  },
  "keywords": [
    "connectivitizer",
    "remote-access",
    "nat-traversal",
    "peer-to-peer",
    "end-to-end-encryption",
    "iot"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react-native": {
      "types": "./dist/react-native.d.ts",
      "default": "./dist/react-native.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "connectivitizer": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test \"build-test/test/**/*.test.js\"",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "~5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
